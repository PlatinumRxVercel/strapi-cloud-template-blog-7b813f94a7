{
  "kind": "collectionType",
  "collectionName": "blogs",
  "info": {
    "singularName": "blog",
    "pluralName": "blogs",
    "displayName": "Blog",
    "description": "Strapi-powered article pages synced to flexipill-core"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "cover": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "metaTitle": {
      "type": "string"
    },
    "metaDescription": {
      "type": "text"
    },
    "body": {
      "type": "dynamiczone",
      "components": [
        "blog.section",
        "blog.medicine-list",
        "blog.article-list",
        "blog.category-list",
        "blog.table",
        "blog.faq-block",
        "blog.references-block"
      ]
    }
  }
}
